# secrets.cfg.example — copy to secrets.cfg on the host and fill in there.
# secrets.cfg is git-ignored. Rotate any value that has ever been committed,
# pasted in chat, or shipped inside a legacy server archive.
sv_licenseKey "<from keymaster, never committed>"
set mysql_connection_string "<mariadb connection string for a least-privilege app user>"
set sentinel_ingest_token "<random token shared with sentinel-ingest>"
# rcon_password is intentionally not set: use txAdmin with MFA (NET-004, SEC-013).
